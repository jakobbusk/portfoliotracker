<%- include('../partials/head') %>

<%- include('../partials/navbar') %>

<main class="flex-column">
	<header>
		<div>
			<h1>Dashboard</h1>
			<p>Velkommen til dit portfolio tracker dashboard!</p>
		</div>
	</header>
	<div class="flex-container">
		<div class="flex-item-fullwidth stats-card">
			<h3>Total værdi</h3>
			<div class="flex-row">
			  <p class="stats-value" id="totalValue">henter...</p>
			</div>
		  </div>
		<div class="flex-item-fullwidth stats-card" >
			<h3>Total realiseret gevinst</h3>
			<div class="flex-row">
			  <p class="stats-value" id="totalRealisedPnL">henter...</p>
			</div>
		  </div>

		  <div class="flex-item-fullwidth stats-card">
			<h3>Total urealiseret gevinst</h3>
			<div class="flex-row">
			  <p class="stats-value" id="totalUnrealisedPnL">henter...</p>
			</div>
		  </div>


	</div>
	<div class="flex-container">
		<div class="flex-item flex-item-fullwidth">
			<h2>Top 5 værdipapirer baseret på værdi</h2>
			<div id="top5Value"></div>
		</div>
		<div class="flex-item flex-item-fullwidth">
			<h2>Top 5 værdipapirer baseret på urealiseret gevinst</h2>
			<div id="top5Unrealised"></div>
		</div>
	</div>

	</div>

</main>
<%- include('../partials/footer') %>


<script type="module">
	import api from '/assets/js/api.js';
    import createTable from '/assets/js/table.js';
	import {createLineChart} from '/assets/js/chart.js';

	//hent de elementer fra stat cards i toppen af siden hvor værdierne skal indsættes
	const totalValueText = document.getElementById('totalValue');
	const totalRealisedPnLText = document.getElementById('totalRealisedPnL');
	const totalUnrealisedPnLText = document.getElementById('totalUnrealisedPnL');
	// Funktion til at hente 3 statistikker
	async function getStatistics(){
		try {
			//henter stats fra dashboard api
			const response = await api('dashboard');
			const data = await response.json();

			//indsæt vædier i innerText i valutaformat
			totalValueText.innerText = Intl.NumberFormat('da-DK', {
				style: 'currency',
				currency: 'USD',
			}).format(data.totalValue);
			totalRealisedPnLText.innerText = Intl.NumberFormat('da-DK', {
				style: 'currency',
				currency: 'USD',
			}).format(data.totalRealisedPnL);
			totalUnrealisedPnLText.innerText = Intl.NumberFormat('da-DK', {
				style: 'currency',
				currency: 'USD',
			}).format(data.totalUnrealisedPnL);
		} catch (error) {
			console.error(error);
			alert('Der opstod en fejl under hentning af statistikkerne. Prøv venligst igen senere.');
		}
	}
	getStatistics();

	//top 5 tabel options objekt
	const top5Valueoptions = {
		link: {
			href: '/symbols',
			key: 'assetSymbol',
		},
		columns: [
			{
				name: 'Navn',
				key: 'assetName',
				callback: (value) => { //opretter element med virksomhedens navn i stort og symbol under i lille
					const assetName = value.assetName;
					const assetSymbol = value.assetSymbol;
					const element = document.createElement('span');
					element.innerHTML =`${assetName}<p>${assetSymbol}</p>`; //p elementet med assetSymbol bliver mindre grundet særlig styling i style.css
					return element
				}
			},
			{
				name: 'Portefølje',
				key: '',
				callback: (value) => { //returnerer link/knap til tilhørende portefølje
					const portfolioID = value.portfolioID;
					const portfolioName = value.portfolioName;
					const element = document.createElement('a');
					element.className = 'table-button';
					element.innerText = portfolioName;
					element.href = `/portfolios/${portfolioID}`
					return element;
				}
			},
			{
				name: 'Markedsværdi',
				key: 'totalValue',
				callback: (row) => {
					return Intl.NumberFormat('da-DK', {
                                style: 'currency',
                                currency: 'USD',
                            }).format(row.totalValue);
				},
			}
		]
	}

	async function top5Value() {
		const response = await api('portfolios/top5/value')
		const data = await response.json();
		createTable(
			data,
			top5Valueoptions,
			'top5Value'
		)
	}
	top5Value();



	//top 5 tabeller
	//options er de samme som top 5 værdi, bortset fra at unrealisedValue er tilføjet
	const top5UnrealisedOptions = {
	link: {
		href: '/symbols',
		key: 'assetSymbol',
	},
	columns: [
		{
			name: 'Navn',
			key: 'assetName',
			callback: (value) => {
				const assetName = value.assetName;
				const assetSymbol = value.assetSymbol;
				const element = document.createElement('span');
				element.innerHTML =`${assetName}<p>${assetSymbol}</p>`;
				return element
			}
		},
		{
			name: 'Portefølje',
			key: '',
			callback: (value) => {
				const portfolioID = value.portfolioID;
				const portfolioName = value.portfolioName;
				const element = document.createElement('a');
				element.className = 'table-button';
				element.innerText = portfolioName;
				element.href = `/portfolios/${portfolioID}`
				return element;
			}
		},
		{
			name: 'Urealiseret gevinst',
			key: 'unrealisedPnL',
			callback: (row) => {
				return Intl.NumberFormat('da-DK', {
							style: 'currency',
							currency: 'USD',
				}).format(row.unrealisedPnL);
			},
		},
		{
				name: 'Markedsværdi',
				key: 'totalValue',
				callback: (row) => {
					return Intl.NumberFormat('da-DK', {
                                style: 'currency',
                                currency: 'USD',
                            }).format(row.totalValue);
				},
			}
	]
}

	async function top5Unrealised() {
		const response = await api('portfolios/top5/upnl')
		const data = await response.json();
		createTable(
			data,
			top5UnrealisedOptions,
			'top5Unrealised'
		)
	}
	top5Unrealised();



</script>