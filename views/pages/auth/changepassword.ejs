<%- include('../../partials/head') %>

<%- include('../../partials/navbar') %>

    <main class="flex-column">
        <header>
            <h1>Skift adgangskode</h1>
            <p>Vælg en sikker adgangskode</p>
        </header>
        <div class="flex-container">
          <div class="flex-item flex-item-fullwidth">
            <form id="changepassword" class="flex-center flex-column">
                <input type="password" name="oldPassword" id="oldPassword" placeholder="Nuværende password" required>
                <input type="password" name="newPassword" id="newPassword" placeholder="Nyt password" required>
                <input type="password" name="confirmNewPassword" id="confirmNewPassword" placeholder="Bekræft nyt password" required>
                <button type="submit" class="button">Skift adgangskode</button>
            </form>
        </div>
    </main>

<%- include('../../partials/footer') %>

<script type="module" src="/assets/js/pages/changepassword.js"></script>