<%- include('../../partials/head') %>

<%- include('../../partials/navbar') %>

    <main class="flex-column">
        <header>
            <div>
                <h1 id="portfolioName"></h1>
                <p id="portfolioDesc"></p>
            </div>

            <div class="flex-container">
                <a id="portfolioDashboardLink" class="button button-active">Dashboard</a>
                <a id="portfolioHistoryLink" class="button">Handels historik</a>
                <a id="portfolioTradeLink" href="/symbols" class="button">Registrer handel</a>
            </div>
        </header>


        <div id="portfolioDashboard" style="display: block;">
            <%- include('./dashboard') %>
        </div>

        <div id="portfolioHistory" style="display: none;">
            <%- include('./history') %>
        </div>

    </main>
<%- include('../../partials/footer') %>

<script type="module">
    import api from '/assets/js/api.js';
    import createTable from '/assets/js/table.js';
    import {createLineChart, createPieChart} from '/assets/js/chart.js';

    // Skift mellem visninger
    const portfolioDashboardLink = document.getElementById('portfolioDashboardLink');
    const portfolioHistoryLink = document.getElementById('portfolioHistoryLink');
    const portfolioTradeLink = document.getElementById('portfolioTradeLink');
    function setView(view) {
        //hent data til view
        if(view === 'dashboard') {
            fetchPortfolioPositions();
        } else if(view === 'history') {
            fetchPortfolioHistory();
        };
        //sæt valgte side til display: block, resten til none så de skjules
        document.getElementById('portfolioDashboard').style.display = view === 'dashboard' ? 'block' : 'none';
        document.getElementById('portfolioHistory').style.display = view === 'history' ? 'block' : 'none';
        document.getElementById('portfolioTrade').style.display = view === 'trade' ? 'block' : 'none';

        //marker sidens tilhørende sideknap som aktiv
        switch (view) {
            case 'dashboard':
                portfolioDashboardLink.classList.add('button-active')
                portfolioHistoryLink.classList.remove('button-active')
                portfolioTradeLink.classList.remove('button-active')
                break;
            case 'history':
                portfolioDashboardLink.classList.remove('button-active')
                portfolioHistoryLink.classList.add('button-active')
                portfolioTradeLink.classList.remove('button-active')
                break;
            case 'trade':
                portfolioDashboardLink.classList.remove('button-active')
                portfolioHistoryLink.classList.remove('button-active')
                portfolioTradeLink.classList.add('button-active')
                break;
            default:
                break;
        }
    }
    //sæt view når der trykkes på tilhørende knap
    portfolioDashboardLink.addEventListener('click', () => {
        setView('dashboard');
    });
    portfolioHistoryLink.addEventListener('click', () => {
        setView('history');
    });
    portfolioTradeLink.addEventListener('click', () => {
        setView('trade');
    });

    // Vi ved at den første del af URL'en er /portfolios/
    // og den sidste del er portfolioID
    // Vi skal have fat i portfolioID
    const url = window.location.href.split('/');
    // Vi tager længden af URL'en og trækker 1 fra for at få den sidste del
    const portfolioID = url[url.length - 1];


    // Funktion til at hente porteføljeoplysninger
    const portfolioName = document.getElementById('portfolioName');
    const portfolioDesc = document.getElementById('portfolioDesc');
    const totalRealisedPnLText = document.getElementById('totalRealisedPnL');
    async function fetchPortfolio(){
        try {
            const response = await api(`portfolios/${portfolioID}`,'GET')
            const portfolioDetails = await response.json();

            portfolioName.innerText = portfolioDetails.name;
            portfolioDesc.innerText = `Tilknyttet konto: ${portfolioDetails.accountName}`;

            if(portfolioDetails.realisedPnL == null) {
                portfolioDetails.realisedPnL = 0;
            }
            //realiseret gevinst hentes sammen med porteføljen, så den tilføjes nu
            totalRealisedPnLText.innerText = portfolioDetails.realisedPnL.toLocaleString('da-DK', {
                style: 'currency',
                currency: 'USD',
            });


        } catch (error) {
            alert('Der opstod en fejl under hentning af porteføljen');
            console.error('Error fetching portfolios:', error);
        }
    }
    await fetchPortfolio();


    const portfolioPosTable = document.getElementById('portfolioPosTable');
    //options til createTable
    const portfolioTableOptions = {
        columns: [
            { name: 'Aktie', key: 'assetName' },
            { name: 'Antal', key: 'quantity' },
            { name: 'GAK', key: 'GAK' },
            { name: 'Værdi', key: 'totalValue', callback: (row) => {
                return row.totalValue.toLocaleString('da-DK', {
                    style: 'currency',
                    currency: row.assetCurrency || 'USD',
                });
            }
            },
            {
                name: 'Urealiseret gevinst',
                key: 'unrealisedPnL',
                callback: (row) => { //urealiseret gevinst regnes ud fra totalværdi, GAK og antal stk
                    return (row.totalValue - (row.GAK * row.quantity)).toLocaleString('da-DK', {
                        style: 'currency',
                        currency: row.assetCurrency || 'USD',
                    });
                }
            },
            {
						name: 'Handlinger',
						key: 'symbol',
						callback: (value) => {
                            //returnerer sælg knap/link i form af a element
							const symbol = value.assetSymbol;
							const link = document.createElement('a');
							link.className = 'table-button'
							link.href = `/symbols/${symbol}/sell`;
							link.innerText = 'Sælg';
							return link;
						}

					}
        ]
    }
    const totalMarketValueText = document.getElementById('totalMarketValue');
    const totalUnrealisedPnLText = document.getElementById('totalUnrealisedPnL');
    const totalAcquisitionValueText = document.getElementById('totalAcquisitionValue');
    //henter alle porteføljens positioner
    async function fetchPortfolioPositions() {
        try {
            const response = await api(`portfolios/${portfolioID}/positions`, 'GET');
            const portfolioPositions = await response.json();

            //først sættes totaler til 0
            let totalMarketValue = 0;
            let totalUnrealisedPnL = 0
            let totalAcquisitionValue = 0;
            //herefter loopes gennem alle porteføljer og de lægges til totalerne
            portfolioPositions.forEach(row => {
                totalMarketValue += row.totalValue;
                totalUnrealisedPnL += row.totalValue - (row.GAK * row.quantity);
                totalAcquisitionValue += row.GAK * row.quantity;
            });
            //til sidst sættes totalerne ind i korrekt valutaformat
            totalMarketValueText.innerText = totalMarketValue.toLocaleString('da-DK', {
                style: 'currency',
                currency: 'USD',
            });
            totalUnrealisedPnLText.innerText = totalUnrealisedPnL.toLocaleString('da-DK', {
                style: 'currency',
                currency: 'USD',
            });
            totalAcquisitionValueText.innerText = totalAcquisitionValue.toLocaleString('da-DK', {
                style: 'currency',
                currency: 'USD',
            });

            //opret tabel over positioner
            createTable(portfolioPositions, portfolioTableOptions, "portfolioPosTable");
            //opret pie chart over positioner
            createPieChart(portfolioPositions,'Fordeling af værdi','positionPieChart');

        } catch (error) {
            alert('Der skete en fejl under hentning af porteføljens positioner');
            console.error('Error fetching portfolio positions:', error);
        }
    }
    await fetchPortfolioPositions();

    // Logik til at hente handels historik
    const portfolioHistoryTable = document.getElementById('portfolioHistoryTable');
    //options til createTable
    const portfolioHistoryTableOptions = {
        columns: [
            { name: 'Aktie', key: 'assetName' },
            { name: 'Antal', key: 'quantity' },
            { name: 'Kurs', key: 'tradeRate' },
            {
                name: 'Gebyr',
                key: 'tradingFee',
                callback: (row) => {
                    return row.tradingFee.toLocaleString('da-DK', {
                        style: 'currency',
                        currency: row.assetCurrency || 'USD',
                    });
                }
            },
            { name: 'Værdi', key: 'value', callback: (row) => {
                //værdien af en handel regnes som kurs * antal stk + gebyr
                const tradeRate = row.tradeRate;
                const quantity = row.quantity;
                const tradingFee = row.tradingFee;
                const value = (tradeRate * quantity) + tradingFee;
                return value.toLocaleString('da-DK', {
                    style: 'currency',
                    currency: row.assetCurrency || 'USD',
                });
                }
            },
            {
                name: 'Realiseret gevinst',
                key: 'realisedPnL',
                callback: (row) => {
                    if(row.realisedPnL == null) {
                        return 'Ikke realiseret';
                    }
                    return row.realisedPnL.toLocaleString('da-DK', {
                        style: 'currency',
                        currency: row.assetCurrency || 'USD',
                    });
                }

            },
            { name: 'Type', key: 'tradeType', callback: (row) => {
                return row.tradeType == 'buy' ? 'Køb' : 'Salg';
                }
            },
            { name: 'Dato', key: 'created_at' },
        ]
    }

    //henter handelshistorik for porteføljen og opretter tabel ud fra options ovenfor
    async function fetchPortfolioHistory() {
        try {
            const response = await api(`trades/${portfolioID}`, 'GET');
            const portfolioHistory = await response.json();

            createTable(portfolioHistory, portfolioHistoryTableOptions, "portfolioHistoryTable");

        } catch (error) {
            alert('Der skete en fejl under hentning af porteføljens handels historik');
            console.error('Error fetching portfolio history:', error);
        }
    }


    // funktion til portfolio unrealised gains history linjegraf
    function createValueChart(historyData){
        try {
            //kalder createLineChart fra chart.js
            createLineChart(
                historyData,
                {title: 'Total urealiseret gevinst', seriesName: 'Total urealiseret gevinst series', currency: 'USD'},
                'totalValueChart'
            )
        } catch (error) {
            alert('Fejl ved generering af graf')
            console.log(error)
        }
    }

    // Hent data til grafen
    async function fetchPortfolioValueHistory() {
        try {
            const response = await api(`portfolios/${portfolioID}/historical`, 'GET');
            const portfolioValueHistory = await response.json();

            //apex skal have data som en array med objekter der indeholder x og y værdier
            //looper igennem alle resultater og sætter x til dato og y til urealiseret værdi
            let historyData = []
            portfolioValueHistory.forEach(row => {
                historyData.push({
                    x: new Date(row.created_at),
                    y: row.totalUnrealisedPnL
                })
            })

            createValueChart(historyData);
        } catch (error) {
            alert('Der skete en fejl under hentning af porteføljens værdi historik');
            console.error('Error fetching portfolio value history:', error);
        }
    }
    await fetchPortfolioValueHistory();
</script>