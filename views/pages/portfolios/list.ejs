<%- include('../../partials/head') %>

<%- include('../../partials/navbar') %>

    <main class="flex-column">
        <header>
            <div>
                <h1>Porteføljer</h1>
                <p>Se alle dine porteføler her</p>
            </div>

            <div>
                <a href="/portfolios/create" class="button">Opret portefølje</a>
            </div>

        </header>

        <div class="flex-container">
            <div class="flex-column ">
                <div class="flex-item">
                  <h3>Total portefølje værdi i DKK</h3>
                  <p>10</p>
                </div>
                <div class="flex-item">
                  <h3>Total realiseret gevinst</h3>
                </div>
            </div>
            <div>
                <div class="flex-item flex-item-fullwidth">
                  <h3>Total urealiseret gevinst</h3>
                </div>
            </div>
        </div>

        <div class="flex-container">
            <div class="flex-item flex-item-fullwidth">
                <div id="portfolioTable"></div>
            </div>
        </div>
    </main>
<%- include('../../partials/footer') %>

<script type="module">
    import api from '/assets/js/api.js';
    import createTable from '/assets/js/table.js';


    // Funktion til at hente alle konti
    async function fetchPortfolios(){
        try {
            const response = await api('portfolios','GET')
            const portfolios = await response.json();
            const options = {
                link: {
                    key: 'id',
                    href: '/portfolios',
                },
                columns: [
                    { name: 'Portefølje', key: 'name' },
                    { name: 'Konto', key: 'accountName'},
                ]
            }

            createTable(portfolios, options, "portfolioTable");

        } catch (error) {
            alert('Der skete en fejl under hentning af konti');
            console.error('Error fetching portfolios:', error);
        }
    }

    await fetchPortfolios();
</script>