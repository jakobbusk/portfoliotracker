<%- include('../../partials/head') %>

<%- include('../../partials/navbar') %>

<main class="flex-column">
	<header>
		<div>
			<h1>Søg efter symbols her</h1>
		</div>
	</header>

	<div class="flex-container flex-column">
		<div class="flex-row flex-center">
            <div class="flex-container">
                <form id="symbolLookupForm" class="flex-row">
                    <input type="text" id="symbolLookup" placeholder="Søg efter symbol" />
                    <button type="submit" id="searchButton">Søg</button>
                </form>
            </div>
		</div>
		<div class="flex-item flex-item-fullwidth">
            <div id="symbolsSearchTable"></div>

		</div>
    </div>


</main>
<%- include('../../partials/footer') %>
<script type="module">
	import api from '/assets/js/api.js';
    import createTable from '/assets/js/table.js';

	// Logik til at håndtere symbolopslag
	//hent form, søgefelt og knap
	const symbolLookupForm = document.getElementById('symbolLookupForm');
	const symbolLookup = document.getElementById('symbolLookup');
	const searchButton = document.getElementById('searchButton');

	//eventListener til knap
	symbolLookupForm.addEventListener('submit', async (event) => {
		event.preventDefault();

		const symbol = symbolLookup.value;

		try {
			const response = await api(`services/symbols?q=${symbol}`, 'GET');
			if (response.ok) {
				const data = await response.json();
				//options til createTable funktion
                const options = {
					//link hver række til symbolets side
                    link: {href: '/symbols', key: 'symbol'},
                    columns: [
                    {
                        name: 'Navn',
                        key: 'description',
                    },
                    {
                        name: 'Ticker',
                        key: 'symbol'

                    },
					{
						name: 'Handlinger',
						key: 'symbol',
						callback: (value) => {
							//returnerer a element der fungerer som købknap
							const symbol = value.symbol;
							const link = document.createElement('a');
							link.className = 'table-button'
							link.href = `/symbols/${symbol}/trade`;
							link.innerText = 'Køb';
							return link;
						}

					}
                ]
            }

                createTable(data, options, "symbolsSearchTable");

			} else {
				alert('Der skete en fejl ved opslag af symbolet');
			}
		} catch (error) {
			console.error('Error fetching stock data:', error);
		}
	});



</script>