<%- include('../../partials/head') %>

<%- include('../../partials/navbar') %>

    <main class="flex-column">
        <header>
            <div>
                <h1>Konti</h1>
                <p>Se alle dine konti her</p>
            </div>
            <div>
                <a href="/accounts/create" class="button">Opret konto</a>
            </div>

        </header>

        <div class="flex-container">
            <div class="flex-item-fullwidth">
                <div id="accountTable" class="table-container">
                </div>
            </div>
        </div>
    </main>
<%- include('../../partials/footer') %>

<script type="module">
    import api from '/assets/js/api.js';
    import createTable from '/assets/js/table.js';

    // Funktion til at hente alle konti
    async function fetchAccounts(){
        try {
            const response = await api('accounts','GET')
            const accounts = await response.json();
            const options = {
                link: {
                    key: 'id',
                    href: '/accounts',
                },
                columns: [
                    { name: 'Konto', key: 'name'},
                    { name: 'Bank', key: 'bankReference' },
                    { name: 'Valuta', key: 'currency' },
                    { name: 'Saldo', key: 'balance', callback: (row) => {
                        return row.balance.toLocaleString('da-DK', {
                            style: 'currency',
                            currency: row.currency,
                        });
                        }
                    },
                    { name: 'Status', key: 'closed', callback: (row) => {
                        let innerText;
                        let stylingClass;
                        if (row.closed){
                            innerText = "Lukket";
                            stylingClass = "negative";
                        } else {
                            innerText = "Åben";
                            stylingClass = "positive";
                        };
                        let element = document.createElement('span');
                        element.innerText = innerText;
                        element.className = stylingClass;
                        return element;
                    }},
                ]
            }

            createTable(accounts, options, "accountTable");
        } catch (error) {
            alert('Der skete en fejl under hentning af konti');
            console.error('Error fetching accounts:', error);
        }
    }

    await fetchAccounts();
</script>