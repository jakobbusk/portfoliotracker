<%- include('../../partials/head') %>

<%- include('../../partials/navbar') %>

    <main class="flex-column">
        <header>
            <div>
                <h1 id="accountName"></h1>
                <h2 id="accountBalance"></h2>
                <p><span id="accountBank"></span> - <span id="accountCurrency"></span></p>
            </div>
            <div class="flex-row">
                <a id="transactionsButton" class="button button-active">Transaktioner</a>
                <a id="withdrawButton" class="button">Hæv penge</a>
                <a id="depositButton" class="button">Indsæt penge</a>
                <button id="closeOpenButton" class="button-negative">Luk konto</button>
            </div>

        </header>
        <div id="depositContainer" class="flex-container" style="display: none;">
            <div class="flex-item flex-item-fullwidth ">
                <h2>Indsæt penge</h2>
                <form id="depositForm" class="flex-center flex-column">
                    <input type="number" id="amount" name="amount" min="0" step="0.01" placeholder="Beløb" required>
                    <label for="currency">Valuta</label>
                    <select id="currency" required>
                        <option value="DKK">DKK</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="GBP">GBP</option>
                    </select>
                    <label for="exchangeRate">Kurs</label>
                    <input type="number" id="exchangeRate" name="exchangeRate" required readonly>
                    <p id="insertedValue"></p>
                    <button type="submit">Indsæt penge</button>
                </form>
            </div>
        </div>
        <div id="withdrawContainer" class="flex-container" style="display: none;">
            <div class="flex-item flex-item-fullwidth">
                <h2>Hæv penge</h2>
                <div class="flex-center flex-column">
                    <form id="withdrawForm" class="flex-column">
                            <input type="number" id="withdrawAmount" name="withdrawAmount" placeholder="Beløb" required>
                            <p id="withdrawedValue"></p>
                            <button type="submit">Hæv penge</button>
                    </form>
                </div>
            </div>
        </div>
        <div id="transactionContainer" class="flex-container">
            <div class="flex-item-fullwidth">
                <h2>Alle transaktioner her</h2>
                <div id="transactionTable" class="table-container">
                </div>
            </div>
        </div>
    </main>

<%- include('../../partials/footer') %>


<script type="module">
    import api from '/assets/js/api.js';
    import createTable from '/assets/js/table.js';

    // Hent alle knapperne
    const transactionsButton = document.getElementById('transactionsButton');
    const withdrawButton = document.getElementById('withdrawButton');
    const depositButton = document.getElementById('depositButton');
    const closeOpenButton = document.getElementById('closeOpenButton');

    //vi viser/skjuler de forskellige sider når der trykkes på sideknapperne
    //vi bruger display: none til at skjule
    transactionsButton.addEventListener('click', () => {
        document.getElementById('transactionContainer').style.display = 'flex';
        document.getElementById('withdrawContainer').style.display = 'none';
        document.getElementById('depositContainer').style.display = 'none';

        //highlight knap tilhørende aktiv side
        transactionsButton.classList.add('button-active')
        withdrawButton.classList.remove('button-active')
        depositButton.classList.remove('button-active')
    });
    withdrawButton.addEventListener('click', () => {
        document.getElementById('transactionContainer').style.display = 'none';
        document.getElementById('withdrawContainer').style.display = 'flex';
        document.getElementById('depositContainer').style.display = 'none';
        transactionsButton.classList.remove('button-active')
        withdrawButton.classList.add('button-active')
        depositButton.classList.remove('button-active')
    });
    depositButton.addEventListener('click', () => {
        document.getElementById('transactionContainer').style.display = 'none';
        document.getElementById('withdrawContainer').style.display = 'none';
        document.getElementById('depositContainer').style.display = 'flex';
        transactionsButton.classList.remove('button-active')
        withdrawButton.classList.remove('button-active')
        depositButton.classList.add('button-active')
    });

    //EventListener til åbning og lukning af konto
    closeOpenButton.addEventListener('click', async () => {
        try {
            let state = 'close';
            if (account.closed){state = 'open'}
            //PUT kald til at ændre status
            const response = await api(`/accounts/${accountID}/${state}`,`PUT`)
            location.reload()
        } catch (error) {
            alert('Der skete en fejl under åbning/lukning af konto')
            console.log('Error opening/closing account: ' + error)
        }
    });

    // hent alle steder
    const accountName = document.getElementById('accountName');
    const accountBalance = document.getElementById('accountBalance');
    const accountBank = document.getElementById('accountBank');
    const accountCurrency = document.getElementById('accountCurrency');


    // Vi ved at den første del af URL'en er /accounts/
    // og den sidste del er accountID
    // Vi skal have fat i accountID
    const url = window.location.href.split('/');
    // Vi tager længden af URL'en og trækker 1 fra for at få den sidste del
    const accountID = url[url.length - 1];

    // Funktion til at hente account objekt
    async function fetchAccount(){
        try {
            const response = await api(`/accounts/${accountID}`,'GET')
            const account = await response.json();

            console.log(account);
            accountName.innerText = account.name;
            accountBank.innerText = account.bankReference;
            accountCurrency.innerText = account.currency;
            accountBalance.innerText = Intl.NumberFormat('da-DK', { //formatering af valuta
                                        style: 'currency',
                                        currency: account.currency,
                                        }).format(account.balance);

            //ændr open/close account knap til open hvis account er lukket
            if (account.closed){
                closeOpenButton.innerText = "Åbn konto";
                closeOpenButton.className = "button-positive";
            };

            //options til createTable
            const options = {
                columns: [

                    {
                        name: 'Beløb',
                        key: 'amount',
                        callback: (row) => {
                            if(row.transactionType === 'withdraw') row.amount = -row.amount;

                            return Intl.NumberFormat('da-DK', {
                                style: 'currency',
                                currency: row.currency,
                            }).format(row.amount);
                        }
                    },
                    {
                        name: 'Kurs',
                        key: 'exchangeRate'
                    },
                    {
                        name: 'Saldo efter på konto',
                        key: 'balanceAfter',
                        callback: (row) => {

                            return Intl.NumberFormat('da-DK', {
                                style: 'currency',
                                currency: account.currency,
                            }).format(row.balanceAfter);;
                        }
                    },
                    {
                        name: 'Portefølje',
                        key: 'portfolioName',
                        callback: (row) => { //opretter link til porteføljen
                            if(!row.portfolioName) return '';
                            else {
                                const linkToPortfolio = document.createElement('a');
                                linkToPortfolio.href = `/portfolios/${row.portfolioID}`;
                                linkToPortfolio.innerText = `${row.portfolioName}`;
                                linkToPortfolio.className = 'table-button';
                                return linkToPortfolio;
                            }
                        }
                    },
                    {
                        name: 'Dato',
                        key: 'created_at',
                        callback: (row) => { //datoformatering
                            const date = new Date(row.created_at);

                            return date.toLocaleDateString('da-DK', {
                                year: 'numeric',
                                month: '2-digit',
                                day: '2-digit',
                                hour: '2-digit',
                                minute: '2-digit',
                            });
                        }
                    },
                ],
                reverse: true,
            }

            createTable(account.transactions, options, "transactionTable");

            return account;

        } catch (error) {
            alert('Der skete en fejl under hentning af konti');
            console.error('Error fetching accounts:', error);
        }
    }

    const account = await fetchAccount();


    // Logik til at indsætte penge herunder
    // henter elementer
    const depositForm = document.getElementById('depositForm');
    const amount = document.getElementById('amount');
    const exchangeRate = document.getElementById('exchangeRate');

    // Først laver vi en event listener på valutaen
    const currency = document.getElementById('currency');
    // Start med at sætte valutaen til den konto vi har hentet
    currency.value = account.currency;
    // Så sætter vi kursen til 1
    exchangeRate.value = 1;
    var insertedAmount = 0;
    //når der sker ændring i valgt valuta hentes vekselkurs
    currency.addEventListener('change', async (e) => {
        console.log(accountCurrency);

        const selectedCurrency = e.target.value;
        const response = await api(`services/exchangerate/${selectedCurrency}/${account.currency}`, 'GET');
        const data = await response.json();

        exchangeRate.value = data.conversion_rate;
        changeInsertedValue();
    });
    // Når vi ændrer beløbet så skal vi også have insertedValue
    amount.addEventListener('input', (e) => {
        changeInsertedValue();
    });

    //beregning af indsat værdi i kontos valuta
    function changeInsertedValue() {
        const amountValue = parseFloat(amount.value);
        const exchangeRateValue = parseFloat(exchangeRate.value);
        if (isNaN(amountValue) || isNaN(exchangeRateValue)) {
            insertedAmount = 0;
        } else {
            insertedAmount = amountValue * exchangeRateValue;
        }

        //afrund til 2 decimaler og konverter til string
        insertedAmount = insertedAmount.toFixed(2);
        //ændr teksten i HTML-elementet
        document.getElementById('insertedValue').innerText = `Indsat værdi: ${insertedAmount} ${account.currency}`;
    }

    //eventListener til submit på formularen
    depositForm.addEventListener('submit', async (e) => {
        e.preventDefault(); //undgå standard funktionalitet

        //opret objekt med nødvendig data
        const depositData = {
            amount: parseFloat(amount.value),
            currency: currency.value,
            transactionType: 'deposit',
            exchangeRate: parseFloat(exchangeRate.value),
        }

        //opret transaktionen
        try {
            const response = await api(`/accounts/${accountID}/transactions`, 'POST', depositData);
            const body = await response.json();
            if (response.ok) {
                alert('Indbetaling gennemført');
                window.location.reload();
            } else if (response.status === 400){
                alert(body.message)
            } else {
                alert('Der skete en fejl under indbetaling');
            }
        } catch (error) {
            console.error('Error depositing money:', error);
            alert('Der skete en fejl under indbetaling');
        }
    });


    // Logik til at hæve penge herunder
    // Fungerer stort set på samme måde som deposit
    const withdrawForm = document.getElementById('withdrawForm');
    const withdrawAmount = document.getElementById('withdrawAmount');
    var withdrawedAmount = 0;
    withdrawAmount.addEventListener('input', (e) => {
        const amountValue = parseFloat(withdrawAmount.value);
        if(isNaN(amountValue)) {
            withdrawedAmount = 0;
        } else {
            withdrawedAmount = amountValue;
        }

        withdrawedAmount = withdrawedAmount.toFixed(2);
        document.getElementById('withdrawedValue').innerText = `Hævet værdi: ${withdrawedAmount} ${account.currency}`;
    });

    withdrawForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const withdrawData = {
            amount: parseFloat(withdrawAmount.value),
            currency: account.currency,
            transactionType: 'withdraw',
            exchangeRate: 1,
        }

        try {
            const response = await api(`accounts/${accountID}/transactions`, 'POST', withdrawData);
            const body = await response.json();
            if (response.ok) {
                alert('Udbetaling gennemført');
                window.location.reload();
            } else if (response.status === 400) {
                alert(body.message);
            } else {
                alert('Der skete en fejl under udbetaling');
            }
        } catch (error) {
            console.error('Error withdrawing money:', error);
            alert('Der skete en fejl under udbetaling'+"catch");
        }
    });
</script>